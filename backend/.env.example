# Vector Strike backend environment template.
# Copy to `.env` and adjust for your machine.
#
# --- Database ----------------------------------------------------------
# PostgreSQL is optional. The project runs on SQLite by default.
# Set DB_ENGINE=postgres to switch to PostgreSQL:
DB_ENGINE=postgres
POSTGRES_DB=vector_strike
POSTGRES_USER=vector_strike
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
#
# --- Django ------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1